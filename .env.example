# TradeDesk configuration — copy to .env and fill in for live mode.
# .env is gitignored. Never commit real secrets.

# Data provider mode: mock | webull
TRADEDESK_MODE=mock

# --- M6 debrief LLM backend (opt-in; default is offline) ---
# Which brain runs the trade-debrief interview (docs/PLAN-M6-TRAINING.md §2).
#
#   none         (DEFAULT — no LLM; a deterministic 4-step form. Zero data
#                 leaves the machine. Zero credentials required. Recommended
#                 for daily use.)
#   claude-cli   (opt-in — shells out to the `claude` CLI you already have
#                 installed. Uses your Claude Pro/Max subscription's monthly
#                 Agent SDK credit pool. Requires the `claude` binary on PATH
#                 and an existing Anthropic OAuth session in ~/.config/claude.)
#   api          (opt-in — official anthropic SDK on your developer key,
#                 pay-per-token billing. Requires ANTHROPIC_API_KEY below.)
#
# WHAT LEAVES YOUR MACHINE when opt-in modes are enabled:
#   * The trade being debriefed: symbol, direction, avg_entry, avg_exit,
#     stop_price, r_multiple, hold_time, fees, net_pnl, session_date, tags,
#     any enrichment notes you've written.
#   * ~40 candles around the trade (symbol OHLCV bars from the trade window).
#   * Your typed replies in the interview.
#
# WHAT NEVER LEAVES:
#   * Credentials (Webull, Anthropic — the app never echoes secrets in prompts).
#   * Any trade OTHER than the one you're actively debriefing.
#   * Your full journal, calendar, or aggregate P&L.
#
# The switch is per-invocation — flip back to `none` any time and the
# offline form runs the same 4-step arc.
TRADEDESK_LLM=none

# Only used when TRADEDESK_LLM=api.
# ANTHROPIC_API_KEY=

# --- Webull OpenAPI (only needed when TRADEDESK_MODE=webull) ---
# Obtain app_key/app_secret from the Webull OpenAPI developer portal.
# US stock market data additionally requires an OpenAPI Quotes Subscription
# (purchase at https://www.webullapp.com/quote — separate from in-app quotes).
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
# Absolute path to the directory that holds the Webull access token file
# (token.txt).  Run `python backend/scripts/webull_auth.py` once to create it.
# Default when unset: <repo_root>/data/webull-token/ (gitignored).
WEBULL_OPENAPI_TOKEN_DIR=/absolute/path/to/data/webull-token

# --- App ---
# The one desk DB; default data/desk.db (relative paths resolve from the repo root).
# TRADEDESK_DB_PATH=data/desk.db
TRADEDESK_TZ=America/New_York
# Default watch tickers (comma-separated)
TRADEDESK_WATCH_TICKERS=RIVN,HOOD
# Opening-range window minutes: 1 | 5 | 15 | 30
TRADEDESK_OR_MINUTES=5
